# Copy to ".env" (gitignored); src/utils/database_service.py loads it automatically.
# Access to the LEMURS study database (PostgreSQL behind an SSH gateway).

LEMURS_SSH_HOST=""
LEMURS_SSH_PORT=22
LEMURS_SSH_USER=""
LEMURS_SSH_KEY_PATH="~/.ssh/id_ed25519"   # or LEMURS_SSH_KEY with the key itself
# LEMURS_SSH_PASSWORD=""

LEMURS_POSTGRES_HOST="localhost"          # as seen from the SSH gateway
LEMURS_POSTGRES_PORT=5432
LEMURS_POSTGRES_DB=""
LEMURS_POSTGRES_USER=""
LEMURS_POSTGRES_PASSWORD=""

# Optional: connection retries when many jobs connect at once
# LEMURS_DB_CONNECT_ATTEMPTS=4
# LEMURS_DB_CONNECT_BACKOFF_S=20

# Optional: Hugging Face / Prior Labs tokens for the foundation-model weights
# HF_TOKEN=""
# TABPFN_TOKEN=""
